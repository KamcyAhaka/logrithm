# Firebase client-side config (get from Firebase Console → Project Settings)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
GOOGLE_APPLICATION_CREDENTIALS=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_PRO_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Set to true to run in demo mode (no Firebase required)
# This is the default for `bun run dev`
NEXT_PUBLIC_DEMO_MODE=false

# Set to true to connect to local Firebase emulators (port 5001)
# Used by `bun run dev:emulator`
NEXT_PUBLIC_USE_EMULATOR=false

# GEMINI_API_KEY and LEADERBOARD_SALT do NOT go here.
# Local dev → put them in functions/.env.local (e.g. LEADERBOARD_SALT=some-local-dev-salt-string)
# Production → store them in GCP Secret Manager as GEMINI_API_KEY and LEADERBOARD_SALT

